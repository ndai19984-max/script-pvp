--[[
    Darling X - Auto Combat Module
    Automated PvP passives: Armament Haki (Buso), Race V3, and Race V4 Awakening.
    Zero emojis, zero third-party references.
    Strict gating: loop only runs while at least one combat passive is enabled.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local LocalPlayer = Players.LocalPlayer

local AutoCombat = {
    AutoBusoEnabled = false,
    AutoV3Enabled = false,
    AutoV4Enabled = false,

    CombatThread = nil,
}

local function checkLoopGating()
    local needLoop = AutoCombat.AutoBusoEnabled or AutoCombat.AutoV3Enabled or AutoCombat.AutoV4Enabled

    if needLoop and not AutoCombat.CombatThread then
        AutoCombat.CombatThread = task.spawn(function()
            while AutoCombat.AutoBusoEnabled or AutoCombat.AutoV3Enabled or AutoCombat.AutoV4Enabled do
                -- 1. Auto Buso Haki
                if AutoCombat.AutoBusoEnabled then
                    pcall(function()
                        local char = LocalPlayer and LocalPlayer.Character
                        if char and not char:FindFirstChild("HasBuso") then
                            local remotes = ReplicatedStorage:FindFirstChild("Remotes")
                            local commF = remotes and (remotes:FindFirstChild("CommF_") or remotes:FindFirstChild("CommF"))
                            if commF then
                                commF:InvokeServer("Buso")
                            end
                        end
                    end)
                end

                -- 2. Auto Race V3
                if AutoCombat.AutoV3Enabled then
                    pcall(function()
                        local remotes = ReplicatedStorage:FindFirstChild("Remotes")
                        local commE = remotes and remotes:FindFirstChild("CommE")
                        if commE then
                            commE:FireServer("ActivateAbility")
                        end
                    end)
                end

                -- 3. Auto Race V4 Awakening
                if AutoCombat.AutoV4Enabled then
                    pcall(function()
                        local awk = (LocalPlayer.Backpack and LocalPlayer.Backpack:FindFirstChild("Awakening"))
                            or (LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Awakening"))
                        if awk and awk:FindFirstChild("RemoteFunction") then
                            awk.RemoteFunction:InvokeServer(true)
                        end
                    end)
                end

                task.wait(1.2)
            end
            AutoCombat.CombatThread = nil
        end)
    elseif not needLoop and AutoCombat.CombatThread then
        pcall(task.cancel, AutoCombat.CombatThread)
        AutoCombat.CombatThread = nil
    end
end

function AutoCombat.SetAutoBuso(state)
    AutoCombat.AutoBusoEnabled = (state == true)
    _G.DarlingX_AutoBuso = AutoCombat.AutoBusoEnabled
    checkLoopGating()
end

function AutoCombat.SetAutoV3(state)
    AutoCombat.AutoV3Enabled = (state == true)
    _G.DarlingX_AutoV3 = AutoCombat.AutoV3Enabled
    checkLoopGating()
end

function AutoCombat.SetAutoV4(state)
    AutoCombat.AutoV4Enabled = (state == true)
    _G.DarlingX_AutoV4 = AutoCombat.AutoV4Enabled
    checkLoopGating()
end

function AutoCombat.ResetAll()
    AutoCombat.SetAutoBuso(false)
    AutoCombat.SetAutoV3(false)
    AutoCombat.SetAutoV4(false)
end

return AutoCombat
--[[
    Darling X - Camlock Module (Classic v2.5 / v2.6 Inspired Engine)
    Clean, deterministic, user-controlled camera locking:
    - Starts in OFF state when enabled in UI (LOCK: OFF).
    - When turned ON (via widget or keybind C), locks onto the enemy currently in crosshairs/front.
    - Stays locked onto that exact person until explicitly turned OFF.
    - When turned OFF, camera returns to 100% normal immediately and stays normal.
    - If the target dies, leaves, or moves >800 studs, it turns OFF cleanly without jumping.
    - Zero emojis, zero third-party references.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local LocalPlayer = Players.LocalPlayer
local Camera = Workspace.CurrentCamera

local Camlock = {
    Enabled = false,
    Active = false,
    Keybind = "C",
    CameraFOV = 70,
    Smoothness = 1,
    MaxDistance = 800,
    Target = nil,
    RenderConn = nil,
    InputConn = nil,
}

local function isEnemy(player)
    if not player or player == LocalPlayer then return false end
    local myChar = LocalPlayer.Character
    if not myChar then return false end

    local myTeam = LocalPlayer.Team
    local theirTeam = player.Team
    if myTeam and theirTeam and myTeam == theirTeam and myTeam.Name == "Marines" then
        return false
    end
    return true
end

local function isAlive(char)
    if not char then return false end
    local hum = char:FindFirstChildOfClass("Humanoid")
    return hum and hum.Health > 0
end

-- Find the target enemy: crosshair priority first, then closest in world (v2.5/2.6 standard)
local function findTarget()
    local myChar = LocalPlayer.Character
    local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not myHRP then return nil, nil end

    local cam = Workspace.CurrentCamera or Camera
    local maxDist = Camlock.MaxDistance or 800
    local bestPlayer = nil
    local bestPart = nil
    local shortestScreenDist = math.huge

    local vpX = (cam and cam.ViewportSize and cam.ViewportSize.X) or 1920
    local vpY = (cam and cam.ViewportSize and cam.ViewportSize.Y) or 1080
    local centerX = vpX / 2
    local centerY = vpY / 2

    -- Pass 1: Enemy on screen closest to crosshair / center
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and isEnemy(p) and isAlive(p.Character) then
            local hrp = p.Character:FindFirstChild("HumanoidRootPart") or p.Character:FindFirstChild("Head")
            if hrp then
                local worldDist = (hrp.Position - myHRP.Position).Magnitude
                if worldDist <= maxDist then
                    local onScreen = true
                    local screenDist = worldDist

                    if cam and cam.WorldToViewportPoint then
                        local ok, sp, vis = pcall(function() return cam:WorldToViewportPoint(hrp.Position) end)
                        if ok and sp then
                            onScreen = (vis == true) or (sp.Z and sp.Z > 0)
                            if onScreen and sp.X and sp.Y then
                                local dx = sp.X - centerX
                                local dy = sp.Y - centerY
                                screenDist = math.sqrt(dx * dx + dy * dy)
                            end
                        end
                    end

                    if onScreen and screenDist < shortestScreenDist then
                        shortestScreenDist = screenDist
                        bestPlayer = p
                        bestPart = hrp
                    end
                end
            end
        end
    end

    if bestPlayer and bestPart then
        return bestPlayer, bestPart
    end

    -- No enemy on screen in front of player: do NOT lock onto anyone in world
    return nil, nil
end

-- Stop locking: disconnects loop, frees camera completely to 100% normal
function Camlock.Unlock()
    if Camlock.RenderConn then
        pcall(function() Camlock.RenderConn:Disconnect() end)
        Camlock.RenderConn = nil
    end

    Camlock.Active = false
    Camlock.Target = nil
    _G.DarlingX_Camlock = false
    _G.DarlingX_CamlockTargetName = nil

    local ew = _G.DarlingX_ExtraWidgets
    if ew and ew.UpdateCamlockVisual then
        pcall(ew.UpdateCamlockVisual, false)
    end

    pcall(function()
        local cam = Workspace.CurrentCamera or Camera
        if cam and LocalPlayer and LocalPlayer.Character then
            local char = LocalPlayer.Character
            local hum = (char.FindFirstChildOfClass and char:FindFirstChildOfClass("Humanoid")) or (char.FindFirstChild and char:FindFirstChild("Humanoid"))
            if hum and cam.CameraSubject ~= hum then
                cam.CameraSubject = hum
            end
        end
    end)

    return false
end

-- Start locking: locks onto the target under crosshair and tracks them until turned off
function Camlock.Lock(targetPlayer, targetPart)
    if not targetPlayer or not targetPart then
        targetPlayer, targetPart = findTarget()
    end

    if not targetPlayer or not targetPart then
        Camlock.Unlock()
        return false
    end

    Camlock.Target = targetPlayer
    Camlock.Active = true
    _G.DarlingX_Camlock = true
    _G.DarlingX_CamlockTargetName = targetPlayer.DisplayName or targetPlayer.Name

    local ew = _G.DarlingX_ExtraWidgets
    if ew and ew.UpdateCamlockVisual then
        pcall(ew.UpdateCamlockVisual, true)
    end

    if Camlock.RenderConn then
        pcall(function() Camlock.RenderConn:Disconnect() end)
        Camlock.RenderConn = nil
    end

    -- Real-time tracking loop: tracks ONLY this specific target until turned off or target drops
    Camlock.RenderConn = RunService.RenderStepped:Connect(function()
        if not Camlock.Active or not _G.DarlingX_Camlock then
            Camlock.Unlock()
            return
        end

        local tPlayer = Camlock.Target
        if not tPlayer or not tPlayer.Character or not isAlive(tPlayer.Character) then
            -- Target died or left: release camera cleanly, DO NOT jump to someone else
            Camlock.Unlock()
            return
        end

        local myChar = LocalPlayer.Character
        local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")
        local eHRP = tPlayer.Character:FindFirstChild("HumanoidRootPart") or tPlayer.Character:FindFirstChild("Head")

        if not myHRP or not eHRP then
            Camlock.Unlock()
            return
        end

        local dist = (eHRP.Position - myHRP.Position).Magnitude
        if dist > Camlock.MaxDistance then
            -- Out of range: release camera cleanly
            Camlock.Unlock()
            return
        end

        local cam = Workspace.CurrentCamera or Camera
        if cam and eHRP.Position then
            local camPos = cam.CFrame.Position
            local aimPos = eHRP.Position + Vector3.new(0, 1.5, 0)
            if (camPos.X == camPos.X) and (aimPos.X == aimPos.X) and (aimPos - camPos).Magnitude > 0.5 then
                pcall(function()
                    if Camlock.Smoothness and Camlock.Smoothness < 1 and Camlock.Smoothness > 0 then
                        cam.CFrame = cam.CFrame:Lerp(CFrame.new(camPos, aimPos), Camlock.Smoothness)
                    else
                        cam.CFrame = CFrame.new(camPos, aimPos)
                    end
                end)
            end
        end
    end)

    return true
end

-- Toggle function: flips cleanly between Lock and Unlock
function Camlock.Toggle()
    if Camlock.Active or _G.DarlingX_Camlock then
        return Camlock.Unlock()
    else
        return Camlock.Lock()
    end
end

-- Master enable: shows widget, but starts with camera lock in OFF state
function Camlock.SetEnabled(state)
    Camlock.Enabled = (state == true)
    _G.DarlingX_CamlockEnabled = Camlock.Enabled

    local ew = _G.DarlingX_ExtraWidgets
    if ew and ew.SetCamlockWidgetVisible then
        pcall(ew.SetCamlockWidgetVisible, Camlock.Enabled)
    end

    -- Always unlock camera when master toggle changes
    Camlock.Unlock()

    if _G.DarlingX_SyncCamlockUI then
        pcall(_G.DarlingX_SyncCamlockUI, Camlock.Enabled)
    end
end

-- Backward-compatibility aliases
function Camlock.SetActive(state)
    if state then
        return Camlock.Lock()
    else
        return Camlock.Unlock()
    end
end

function Camlock.ToggleActive()
    return Camlock.Toggle()
end

function Camlock.StartLoop()
    return Camlock.Lock()
end

function Camlock.StopLoop()
    return Camlock.Unlock()
end

function Camlock.SetKeybind(key)
    Camlock.Keybind = tostring(key or "None")
end

function Camlock.SetCameraFOV(val)
    local num = tonumber(val) or 70
    Camlock.CameraFOV = num
    local cam = Workspace.CurrentCamera or Camera
    if cam then
        cam.FieldOfView = num
    end
end

function Camlock.SetSmoothness(val)
    Camlock.Smoothness = tonumber(val) or 1
end

-- Keybind listener
local function setupInputHook()
    if Camlock.InputConn then return end
    Camlock.InputConn = UserInputService.InputBegan:Connect(function(input, gpe)
        if gpe then return end
        if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
        local key = input.KeyCode.Name
        if Camlock.Keybind ~= "None" and key == Camlock.Keybind then
            Camlock.Toggle()
        end
    end)
end

setupInputHook()

_G.DarlingX_CamlockMod = Camlock
_G.DarlingX_ToggleCamlock = function() return Camlock.Toggle() end
_G.DarlingX_SetCamlock = function(s) return Camlock.SetActive(s) end

return Camlock
--[[
    Darling X - Dragon Gun M1 Ultra Fast Engine
    Exact upvalue resolution and RenderStepped burst loop.
    Zero emojis, zero third-party references.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer

_G.G_DragonGunM1 = false
_G.G_AttackMobs = true
_G.G_AttackPlayers = true
_G.G_AttackSeaEvents = true
_G.G_MaxDistance = 400
_G.G_ShotsPerFrame = 3

local Modules = ReplicatedStorage:WaitForChild("Modules", 5)
local DragonNet = Modules and Modules:WaitForChild("Net", 5)
local ShootGunEvent = DragonNet and DragonNet:WaitForChild("RE/ShootGunEvent", 5)
local Validator2 = ReplicatedStorage:WaitForChild("Remotes", 5):WaitForChild("Validator2", 5)

local getupval = debug.getupvalue or getupvalue
local setupval = debug.setupvalue or setupvalue
local getupvals = debug.getupvalues or getupvalues

local ShootFunction
local V_Idx = { v26 = 12, v22 = 13, v25 = 14, v21 = 15, v23 = 16, v24 = 17, v27 = 18 }

local function InitDragonGun()
    local success, result = pcall(require, ReplicatedStorage:WaitForChild("Controllers"):WaitForChild("CombatController"))
    if success and type(result) == "table" and result.Attack then
        ShootFunction = getupval(result.Attack, 9)
    end
end

local function GetNextValidator()
    if not ShootFunction then InitDragonGun() end
    if not ShootFunction then return 0, 0 end
    local upvals = getupvals(ShootFunction)
    if not upvals then return 0, 0 end
    
    if upvals[V_Idx.v21] ~= 727595 then
        for i, v in pairs(upvals) do
            if v == 727595 then
                local offset = i - 15
                V_Idx.v21 = i; V_Idx.v22 = 13 + offset; V_Idx.v23 = 16 + offset
                V_Idx.v24 = 17 + offset; V_Idx.v26 = 12 + offset; V_Idx.v25 = 14 + offset
                V_Idx.v27 = 18 + offset
                break
            end
        end
    end
    
    local v1 = getupval(ShootFunction, V_Idx.v21)
    local v2 = getupval(ShootFunction, V_Idx.v22)
    local v3 = getupval(ShootFunction, V_Idx.v23)
    local v4 = getupval(ShootFunction, V_Idx.v24)
    local v5 = getupval(ShootFunction, V_Idx.v25)
    local v6 = getupval(ShootFunction, V_Idx.v26)
    local v7 = getupval(ShootFunction, V_Idx.v27)
    
    if not (v1 and v2 and v3 and v4 and v5 and v6 and v7) then return 0, 0 end
    
    local v8 = v6 * v2
    local v9 = (v5 * v2 + v6 * v1) % v3
    v9 = (v9 * v3 + v8) % v4
    v5 = math.floor(v9 / v3)
    v6 = v9 - v5 * v3
    v7 = v7 + 1
    
    setupval(ShootFunction, V_Idx.v25, v5)
    setupval(ShootFunction, V_Idx.v26, v6)
    setupval(ShootFunction, V_Idx.v27, v7)
    return math.floor(v9 / v4 * 16777215), v7
end

local function GetEntityPart(entity)
    return entity:FindFirstChild("HumanoidRootPart") 
        or entity:FindFirstChild("Engine") 
        or entity:FindFirstChild("Head") 
        or entity:FindFirstChild("Base") 
        or entity.PrimaryPart
end

local function GetClosestTarget()
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return nil end
    
    local closest, dist = nil, _G.G_MaxDistance
    local myPos = root.Position

    if _G.G_AttackMobs then
        local enemies = workspace:FindFirstChild("Enemies")
        if enemies then
            for _, enemy in ipairs(enemies:GetChildren()) do
                local hum = enemy:FindFirstChildOfClass("Humanoid")
                local r = GetEntityPart(enemy)
                if hum and hum.Health > 0 and r then
                    local d = (r.Position - myPos).Magnitude
                    if d < dist then dist = d; closest = r end
                end
            end
        end
    end

    if _G.G_AttackSeaEvents then
        local seaFolders = { workspace:FindFirstChild("SeaBeasts"), workspace:FindFirstChild("SeaEvents") }
        for _, folder in ipairs(seaFolders) do
            if folder then
                for _, seaMob in ipairs(folder:GetChildren()) do
                    local hum = seaMob:FindFirstChildOfClass("Humanoid")
                    local r = GetEntityPart(seaMob)
                    if r and (not hum or hum.Health > 0) then
                        local d = (r.Position - myPos).Magnitude
                        if d < dist then dist = d; closest = r end
                    end
                end
            end
        end

        for _, obj in ipairs(workspace:GetChildren()) do
            if obj:IsA("Model") and obj ~= char then
                local name = obj.Name:lower()
                if name:find("ship") or name:find("boat") or name:find("beast") or name:find("terror") or name:find("piranha") or name:find("leviathan") then
                    local hum = obj:FindFirstChildOfClass("Humanoid")
                    local r = GetEntityPart(obj)
                    if r and (not hum or hum.Health > 0) then
                        local d = (r.Position - myPos).Magnitude
                        if d < dist then dist = d; closest = r end
                    end
                end
            end
        end
    end

    if _G.G_AttackPlayers then
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character then
                local hum = player.Character:FindFirstChildOfClass("Humanoid")
                local r = player.Character:FindFirstChild("HumanoidRootPart")
                if hum and hum.Health > 0 and r then
                    local d = (r.Position - myPos).Magnitude
                    if d < dist then dist = d; closest = r end
                end
            end
        end
    end

    return closest
end

-- RenderStepped attack loop
RunService.RenderStepped:Connect(function()
    if not _G.G_DragonGunM1 then return end
    
    local char = LocalPlayer.Character
    local tool = char and char:FindFirstChildOfClass("Tool")
    
    if tool and tool.ToolTip == "Gun" then
        local target = GetClosestTarget()
        if target then
            for i = 1, _G.G_ShotsPerFrame do
                local code, count = GetNextValidator()
                if code ~= 0 and Validator2 then 
                    Validator2:FireServer(code, count) 
                end
                
                tool:SetAttribute("LocalOverheat", 0)
                tool:SetAttribute("LocalTotalShots", (tool:GetAttribute("LocalTotalShots") or 0) + 1)
                
                if ShootGunEvent then
                    ShootGunEvent:FireServer(target.Position, { target })
                end
            end
        end
    end
end)

local function getWidgets()
    if rawget(_G, "DarlingX_ExtraWidgets") then
        return _G.DarlingX_ExtraWidgets
    end
    local hub = rawget(_G, "DarlingHub") or (getgenv and getgenv().DarlingHub)
    if hub and hub.Require then
        local w = hub:Require("modules/pvp/extra_widgets.lua")
        if w then return w end
    end
    local req = (typeof(require) == "function") and require
    if req and script and script.Parent then
        local ok, w = pcall(req, script.Parent.extra_widgets)
        if ok and w then return w end
    end
    return nil
end

-- Keybind G support
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.KeyCode == Enum.KeyCode.G and _G.DarlingX_DragonM1Enabled then
        _G.G_DragonGunM1 = not _G.G_DragonGunM1
        local widgets = getWidgets()
        if widgets and widgets.UpdateDragonM1Visual then
            widgets.UpdateDragonM1Visual(_G.G_DragonGunM1)
        end
    end
end)

local DragonGunModule = {
    SetEnabled = function(state)
        _G.G_DragonGunM1 = (state == true)
        local widgets = getWidgets()
        if widgets and widgets.UpdateDragonM1Visual then
            widgets.UpdateDragonM1Visual(_G.G_DragonGunM1)
        end
    end,
    SetWidgetVisible = function(state)
        local widgets = getWidgets()
        if widgets and widgets.SetDragonM1WidgetVisible then
            widgets.SetDragonM1WidgetVisible(state == true)
        end
    end,
    UpdateVisual = function(state)
        local widgets = getWidgets()
        if widgets and widgets.UpdateDragonM1Visual then
            widgets.UpdateDragonM1Visual(state)
        end
    end,
}

return DragonGunModule
--[[
    Darling X - Unified Luxury Dark Glass Floating Widgets
    Consolidated draggable floating widgets for:
      1. Super Jump (Impulse Trigger)
      2. Camlock (Aim Lock Toggle)
      3. Dragon Gun M1 (Fast Gun Toggle)
      4. Sanguine Boost (Velocity Dash Trigger)
    Features:
      - Clean transparent dark glass styling
      - 6-stud drag threshold (separating drag from click)
      - Feature-gating (taps only function when menu toggle is enabled)
      - DisplayOrder 99999, safe parenting, touch and mouse support
      - Zero emojis, zero third-party references
]]

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local CoreGui = game:GetService("CoreGui")
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer

local function getGuiParent()
    local ok, h = pcall(function() return gethui and gethui() end)
    if ok and h and ((typeof and typeof(h) == "Instance") or type(h) == "userdata" or type(h) == "table") then return h end
    local ok2, c = pcall(function() return CoreGui end)
    if ok2 and c and ((typeof and typeof(c) == "Instance") or type(c) == "userdata" or type(c) == "table") then
        local pOk = pcall(function()
            local t = Instance.new("Folder")
            t.Parent = c
            t:Destroy()
        end)
        if pOk then return c end
    end
    local lp = LocalPlayer or Players.LocalPlayer
    if lp then
        local pg = nil
        pcall(function()
            pg = lp:FindFirstChildOfClass("PlayerGui") or lp:FindFirstChild("PlayerGui")
        end)
        if pg then return pg end
        pcall(function()
            pg = lp:WaitForChild("PlayerGui", 2)
        end)
        if pg then return pg end
    end
    return nil
end

local function ensureParent(gui)
    if not gui then return end
    local p = getGuiParent()
    if p and gui.Parent ~= p then
        pcall(function() gui.Parent = p end)
    end
end

local function makeDraggable(targetFrame, dragHandle, onClick)
    dragHandle = dragHandle or targetFrame
    local dragging = false
    local dragStart = nil
    local startPos = nil
    local startTime = 0
    local isDrag = false
    local lastClickTick = 0

    local function fireClick()
        local now = os.clock()
        if now - lastClickTick < 0.25 then return end
        lastClickTick = now
        if onClick then
            pcall(onClick)
        end
    end

    dragHandle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            isDrag = false
            dragStart = input.Position
            startPos = targetFrame.Position
            startTime = os.clock()
        end
    end)

    dragHandle.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            if dragStart and startPos then
                local delta = input.Position - dragStart
                if delta.Magnitude > 28 then
                    isDrag = true
                    targetFrame.Position = UDim2.new(
                        startPos.X.Scale,
                        startPos.X.Offset + delta.X,
                        startPos.Y.Scale,
                        startPos.Y.Offset + delta.Y
                    )
                end
            end
        end
    end)

    dragHandle.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            if dragging then
                dragging = false
                local duration = os.clock() - startTime
                local totalDist = dragStart and (input.Position - dragStart).Magnitude or 0
                if not isDrag or totalDist < 25 or duration < 0.28 then
                    fireClick()
                end
            end
        end
    end)

    pcall(function()
        if dragHandle:IsA("GuiButton") or dragHandle.Activated then
            dragHandle.Activated:Connect(function()
                if not isDrag then
                    fireClick()
                end
            end)
        end
    end)

    pcall(function()
        if dragHandle:IsA("GuiButton") then
            dragHandle.MouseButton1Click:Connect(function()
                if not isDrag then
                    fireClick()
                end
            end)
        end
    end)
end

local function createGlassWidget(name, size, pos)
    local gui = Instance.new("ScreenGui")
    gui.Name = name
    gui.ResetOnSpawn = false
    gui.DisplayOrder = 99999
    gui.IgnoreGuiInset = true
    gui.Enabled = false
    pcall(function()
        if syn and syn.protect_gui then syn.protect_gui(gui) end
        gui.Parent = getGuiParent()
    end)

    local container = Instance.new("Frame", gui)
    container.Name = name .. "_Container"
    container.Size = size
    container.Position = pos
    container.BackgroundColor3 = Color3.fromRGB(18, 14, 28)
